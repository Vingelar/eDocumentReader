<Window x:Class="eDocumentReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:eDocumentReader.App.ViewModels"
        xmlns:l="clr-namespace:eDocumentReader.App.Localization"
        Title="eDocumentReader" Height="850" Width="1300" Icon="/Assets/eDocumentReader.ico"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="Mono" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{l:Tr '_Einstellungen', En='_Settings'}">
                <MenuItem Header="{l:Tr '_Sprache', En='_Language'}">
                    <MenuItem Header="_Deutsch" IsCheckable="False" IsChecked="{Binding IsGerman, Mode=OneWay}"
                              Command="{Binding SetLanguageCommand}" CommandParameter="de" />
                    <MenuItem Header="_English" IsCheckable="False" IsChecked="{Binding IsEnglish, Mode=OneWay}"
                              Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{l:Tr '_Hilfe', En='_Help'}">
                <MenuItem Header="{l:Tr '_Über eDocumentReader…', En='_About eDocumentReader…'}" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <TextBlock Text="{l:Tr 'Leser:', En='Reader:'}" VerticalAlignment="Center" Margin="3" />
                <ComboBox Width="380" ItemsSource="{Binding Readers}" SelectedItem="{Binding SelectedReader}"
                          IsEnabled="{Binding IsReading, Converter={x:Static vm:InverseBoolConverter.Instance}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="LightGray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CardPresent}" Value="True">
                                                    <Setter Property="Fill" Value="LimeGreen" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="{l:Tr 'Exklusiv', En='Exclusive'}" IsChecked="{Binding ExclusiveMode}" VerticalAlignment="Center" Margin="6,0" />
                <Button Content="{l:Tr 'Verbinden', En='Connect'}" Command="{Binding ConnectCommand}" />
                <Button Content="{l:Tr 'Trennen', En='Disconnect'}" Command="{Binding DisconnectCommand}" />
                <Button Content="Reset" Command="{Binding ResetCommand}" />
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusText}" />
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <TabControl Grid.Row="0">
                <TabItem Header="{l:Tr 'Dokument', En='Document'}">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <!-- Access data, options, procedure -->
                        <DockPanel Grid.Column="0" Margin="0,0,6,0">
                            <GroupBox DockPanel.Dock="Top" Header="{l:Tr 'Zugangsdaten', En='Access data'}">
                                <StackPanel Margin="4">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{l:Tr 'Anwendung', En='Application'}" Width="70" VerticalAlignment="Center" />
                                        <ComboBox SelectedIndex="{Binding ApplicationChoice}" Width="210"
                                                  ToolTip="{l:Tr 'Automatisch: IDL-Anwendung (ISO/IEC 18013-3) vorhanden → Führerschein, sonst eMRTD', En='Automatic: IDL application (ISO/IEC 18013-3) present → driving licence, otherwise eMRTD'}">
                                            <ComboBoxItem Content="{l:Tr 'Automatisch erkennen', En='Detect automatically'}" />
                                            <ComboBoxItem Content="{l:Tr 'Pass / ID-Karte (ICAO 9303)', En='Passport / ID card (ICAO 9303)'}" />
                                            <ComboBoxItem Content="{l:Tr 'Führerschein IDL (ISO 18013-3)', En='Driving licence IDL (ISO 18013-3)'}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <RadioButton Content="MRZ (BAC / BAP / PACE)" IsChecked="{Binding UseCan, Converter={x:Static vm:InverseBoolConverter.Instance}}" Margin="0,0,12,0" />
                                        <RadioButton Content="CAN (PACE)" IsChecked="{Binding UseCan}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseCan}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{l:Tr 'MRZ einfügen (Pass/ID vollständig oder TD3-Zeile 2, Führerschein 30-stellig):', En='Paste the MRZ (passport/ID complete or TD3 line 2, driving licence 30 characters):'}" TextWrapping="Wrap" />
                                        <TextBox Style="{StaticResource Mono}" Text="{Binding MrzInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48"
                                                 VerticalScrollBarVisibility="Auto" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{l:Tr 'Dokumentnummer', En='Document number'}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Margin="0,1" />
                                            <TextBlock Grid.Row="1" Text="{l:Tr 'Geburtsdatum JJMMTT', En='Date of birth YYMMDD'}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Margin="0,1" />
                                            <TextBlock Grid.Row="2" Text="{l:Tr 'Ablaufdatum JJMMTT', En='Date of expiry YYMMDD'}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding DateOfExpiry, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Margin="0,1" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseCan}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{l:Tr 'CAN (6 Ziffern)', En='CAN (6 digits)'}" Width="130" VerticalAlignment="Center" />
                                        <TextBox Style="{StaticResource Mono}" Text="{Binding Can, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Width="90" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AccessKeyHint}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,0" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox DockPanel.Dock="Top" Header="{l:Tr 'Ablauf', En='Procedure'}">
                                <StackPanel Margin="4">
                                    <CheckBox Content="{l:Tr 'PACE bevorzugen (sonst BAC / BAP)', En='Prefer PACE (otherwise BAC / BAP)'}" IsChecked="{Binding PreferPace}" />
                                    <CheckBox Content="Chip Authentication" IsChecked="{Binding RunChipAuthentication}" />
                                    <CheckBox Content="Terminal Authentication (DG3/DG4, IDL: EAP)" IsChecked="{Binding RunTerminalAuthentication}" />
                                    <CheckBox Content="Active Authentication" IsChecked="{Binding RunActiveAuthentication}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="{l:Tr 'Dokument lesen', En='Read document'}" Command="{Binding ReadDocumentCommand}" FontWeight="Bold" />
                                        <Button Content="{l:Tr 'Abbrechen', En='Cancel'}" Command="{Binding CancelReadCommand}" />
                                    </StackPanel>
                                    <Button Content="{l:Tr 'Zulassungsbescheinigung (eVRC) lesen', En='Read registration certificate (eVRC)'}" Command="{Binding ReadEvrcCommand}" HorizontalAlignment="Left"
                                            ToolTip="{l:Tr 'RL 2003/127/EG – frei lesbar, keine Zugangsdaten nötig', En='Directive 2003/127/EC – freely readable, no access data needed'}" />
                                    <ProgressBar Height="14" Margin="0,4,0,0" Value="{Binding ReadProgress}" />
                                    <TextBlock Text="{Binding ReadStage}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="{l:Tr 'Ergebnis', En='Result'}">
                                <ListBox x:Name="StepList" ItemsSource="{Binding ReadSteps}" Margin="4" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="StepList_MouseLeftButtonUp"
                                         ToolTip="{l:Tr 'Klick auf einen Eintrag: zugehörige Stelle im Log anzeigen', En='Click an entry: show its place in the log'}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="1" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontWeight="Bold" Text="{Binding Symbol}" Foreground="{Binding SymbolBrush}" />
                                                <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                    <Setter Property="Foreground" Value="Gray" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding DetailText, Mode=OneWay}" />
                                                </TextBlock>
                                                <ProgressBar Grid.Row="1" Grid.Column="1" Height="6" Margin="0,2,0,1" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>
                        </DockPanel>

                        <!-- MRZ from DG1 -->
                        <DockPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DataPanelTitle}" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBox DockPanel.Dock="Top" Style="{StaticResource Mono}" FontSize="15" Text="{Binding MrzText, Mode=OneWay}" IsReadOnly="True"
                                     HorizontalScrollBarVisibility="Auto" />
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding MrzFindings}" Foreground="DarkOrange" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding MrzRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" Margin="0,4,0,0" CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:Tr 'Feld', En='Field'}" Binding="{Binding Name}" Width="170" />
                                    <DataGridTextColumn Header="{l:Tr 'Wert', En='Value'}" Binding="{Binding Value}" Width="*" FontFamily="Consolas" />
                                    <DataGridTextColumn Header="{l:Tr 'Prüfung', En='Check'}" Binding="{Binding Check}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Facial image from DG2 -->
                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="{l:Tr 'Bild speichern…', En='Save image…'}" Command="{Binding SaveFaceImageCommand}" Margin="0" />
                                <TextBlock Text="{Binding ImagePanelTitle}" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding FaceInfo}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="1" Background="White" Height="70" Margin="0,4,0,0"
                                    ToolTip="{l:Tr 'DG5 – Unterschrift', En='DG5 – signature'}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SignatureBitmap}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding SignatureBitmap}" Stretch="Uniform" />
                            </Border>
                            <Border BorderBrush="LightGray" BorderThickness="1" Background="WhiteSmoke">
                                <Image Source="{Binding FaceBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </DockPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="{l:Tr 'Führerscheindaten', En='Driving licence data'}">
                    <DataGrid ItemsSource="{Binding IdlFields}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserSortColumns="False" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Tr 'Datengruppe / Template', En='Data group / template'}" Binding="{Binding Path}" Width="170" />
                            <DataGridTextColumn Header="Tag" Binding="{Binding TagHex}" Width="55" FontFamily="Consolas" />
                            <DataGridTextColumn Header="{l:Tr 'Bezeichnung', En='Name'}" Binding="{Binding Name}" Width="260" />
                            <DataGridTextColumn Header="{l:Tr 'Wert', En='Value'}" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn Header="{l:Tr 'Befund (ISO/IEC 18013-2 Anhang C)', En='Finding (ISO/IEC 18013-2 Annex C)'}" Width="340" Binding="{Binding Findings, Converter={x:Static vm:JoinLinesConverter.Instance}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="DarkOrange" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{l:Tr 'Fahrzeugdaten', En='Vehicle data'}">
                    <DataGrid ItemsSource="{Binding EvrcFields}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserSortColumns="False" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Tr 'Datei / Template', En='File / template'}" Binding="{Binding Path}" Width="180" />
                            <DataGridTextColumn Header="Tag" Binding="{Binding TagHex}" Width="55" FontFamily="Consolas" />
                            <DataGridTextColumn Header="{l:Tr 'Bezeichnung', En='Name'}" Binding="{Binding Name}" Width="320" />
                            <DataGridTextColumn Header="{l:Tr 'Wert', En='Value'}" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn Header="{l:Tr 'Befund', En='Finding'}" Width="300" Binding="{Binding Findings, Converter={x:Static vm:JoinLinesConverter.Instance}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="DarkOrange" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{l:Tr 'Dateien', En='Files'}">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="{l:Tr 'Datensatz (Set) speichern…', En='Save data set…'}" Command="{Binding SaveSetCommand}" FontWeight="Bold"
                                        ToolTip="{l:Tr 'Ordner mit project.json und ef/*.bin nach SET-FORMAT.md (Import in PaceSetupGen)', En='Folder with project.json and ef/*.bin according to SET-FORMAT.md (import into PaceSetupGen)'}" />
                                <Button Content="{l:Tr 'Datei speichern…', En='Save file…'}" Command="{Binding SaveSelectedFileCommand}"
                                        ToolTip="{l:Tr 'Ausgewählte Datei (oberste Ebene im Baum) als DG&lt;n&gt;.bin / EF.xxx.bin speichern', En='Save the selected file (top level of the tree) as DG&lt;n&gt;.bin / EF.xxx.bin'}" />
                            </StackPanel>
                            <TreeView ItemsSource="{Binding FileNodes}" SelectedItemChanged="FileTree_SelectedItemChanged">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Header}" FontFamily="Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFindings}" Value="True">
                                                            <Setter Property="Foreground" Value="DarkOrange" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                        <DockPanel Grid.Column="2">
                            <TextBox DockPanel.Dock="Top" Style="{StaticResource Mono}" Text="{Binding SelectedFileNode.Details, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" />
                            <TextBox Style="{StaticResource Mono}" Text="{Binding SelectedFileNode.HexDump, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,0"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="{l:Tr 'Sicherheit', En='Security'}">
                    <RichTextBox x:Name="SecurityBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" IsDocumentEnabled="False"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </TabItem>
                <TabItem Header="PKI">
                    <DockPanel Margin="4">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="{l:Tr 'Importieren…', En='Import…'}" Command="{Binding ImportPkiCommand}" FontWeight="Bold"
                                    ToolTip="{l:Tr 'CV-Zertifikate (CVCA, DV, Terminal), private Terminalschlüssel (PKCS#8/PEM), CSCA/DS (X.509), Master Lists, CRLs – Mehrfachauswahl möglich', En='CV certificates (CVCA, DV, terminal), private terminal keys (PKCS#8/PEM), CSCA/DS (X.509), Master Lists, CRLs – multiple selection possible'}" />
                            <Button Content="{l:Tr 'Aktualisieren', En='Refresh'}" Command="{Binding RefreshPkiCommand}" />
                            <Button Content="{l:Tr 'Ordner öffnen', En='Open folder'}" Command="{Binding OpenPkiFolderCommand}" />
                            <TextBlock VerticalAlignment="Center" Foreground="DimGray" Margin="8,0,0,0"
                                       Text="{l:Tr 'Für TA: CVCA-, DV- und Terminalzertifikat sowie den privaten Schlüssel des Terminals importieren.', En='For TA: import the CVCA, DV and terminal certificate and the private key of the terminal.'}" />
                        </StackPanel>
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource Mono}" Text="{Binding PkiImportLog, Mode=OneWay}" IsReadOnly="True"
                                 MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource Mono}" Text="{Binding PkiSummary, Mode=OneWay}" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="{l:Tr 'Leser / Karte', En='Reader / card'}">
                    <RichTextBox x:Name="CardInfoBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" IsDocumentEnabled="False"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </TabItem>
                <TabItem Header="{l:Tr 'APDU-Konsole', En='APDU console'}">
                    <DockPanel Margin="4">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="{l:Tr 'Senden', En='Send'}" Command="{Binding SendApduCommand}" IsDefault="True" />
                            <CheckBox DockPanel.Dock="Right" Content="{l:Tr '61xx/6Cxx automatisch', En='61xx/6Cxx automatically'}" IsChecked="{Binding AutoGetResponse}" VerticalAlignment="Center" Margin="6,0" />
                            <TextBox Style="{StaticResource Mono}" Text="{Binding ApduInput, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBox Style="{StaticResource Mono}" Text="{Binding ApduOutput, Mode=OneWay}" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" />
                    </DockPanel>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
            <DockPanel Grid.Row="2">
                <Expander DockPanel.Dock="Right" ExpandDirection="Left" Header="{l:Tr 'Logdetails', En='Log details'}">
                    <ItemsControl ItemsSource="{Binding LogLevels}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Category}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding Level}"
                                              ItemsSource="{Binding DataContext.AvailableLevels, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock Text="{l:Tr 'Kommunikations- und Berechnungslog', En='Communication and computation log'}" FontWeight="Bold" VerticalAlignment="Center" Margin="4" />
                    <Button Content="{l:Tr 'Leeren', En='Clear'}" Command="{Binding ClearLogCommand}" />
                    <Button Content="{l:Tr 'Speichern…', En='Save…'}" Command="{Binding SaveLogCommand}"
                            ToolTip="{l:Tr 'Vollständiges Log (alle Stufen) speichern', En='Save the complete log (all levels)'}" />
                    <Button Content="{l:Tr 'Gefiltert speichern…', En='Save filtered…'}" Command="{Binding SaveFilteredLogCommand}"
                            ToolTip="{l:Tr 'Nur die mit den Logdetails ausgewählten Einträge speichern', En='Save only the entries selected with the log details'}" />
                </StackPanel>
                <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="12"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Mode=OneWay, Converter={x:Static vm:LogEntryFormatter.Instance}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Foreground" Value="Red" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Foreground" Value="DarkOrange" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Direction}" Value="Command">
                                                <Setter Property="Foreground" Value="DarkBlue" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Direction}" Value="Response">
                                                <Setter Property="Foreground" Value="DarkGreen" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
