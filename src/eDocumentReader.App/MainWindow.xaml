<Window x:Class="eDocumentReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:eDocumentReader.App.ViewModels"
        Title="eDocumentReader" Height="850" Width="1300"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <TextBlock Text="Leser:" VerticalAlignment="Center" Margin="3" />
                <ComboBox Width="380" ItemsSource="{Binding Readers}" SelectedItem="{Binding SelectedReader}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="LightGray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CardPresent}" Value="True">
                                                    <Setter Property="Fill" Value="LimeGreen" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="Exklusiv" IsChecked="{Binding ExclusiveMode}" VerticalAlignment="Center" Margin="6,0" />
                <Button Content="Verbinden" Command="{Binding ConnectCommand}" />
                <Button Content="Trennen" Command="{Binding DisconnectCommand}" />
                <Button Content="Reset" Command="{Binding ResetCommand}" />
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusText}" />
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <TabControl Grid.Row="0">
                <TabItem Header="Dokument">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <!-- Zugangsdaten, Optionen, Ablauf -->
                        <DockPanel Grid.Column="0" Margin="0,0,6,0">
                            <GroupBox DockPanel.Dock="Top" Header="Zugangsdaten">
                                <StackPanel Margin="4">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Anwendung" Width="70" VerticalAlignment="Center" />
                                        <ComboBox SelectedIndex="{Binding ApplicationChoice}" Width="210"
                                                  ToolTip="Automatisch: IDL-Anwendung (ISO/IEC 18013-3) vorhanden → Führerschein, sonst eMRTD">
                                            <ComboBoxItem Content="Automatisch erkennen" />
                                            <ComboBoxItem Content="Pass / ID-Karte (ICAO 9303)" />
                                            <ComboBoxItem Content="Führerschein IDL (ISO 18013-3)" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <RadioButton Content="MRZ (BAC / BAP / PACE)" IsChecked="{Binding UseCan, Converter={x:Static vm:InverseBoolConverter.Instance}}" Margin="0,0,12,0" />
                                        <RadioButton Content="CAN (PACE)" IsChecked="{Binding UseCan}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseCan}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="MRZ einfügen (Pass/ID vollständig oder TD3-Zeile 2, Führerschein 30-stellig):" TextWrapping="Wrap" />
                                        <TextBox Style="{StaticResource Mono}" Text="{Binding MrzInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48"
                                                 VerticalScrollBarVisibility="Auto" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Dokumentnummer" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Margin="0,1" />
                                            <TextBlock Grid.Row="1" Text="Geburtsdatum JJMMTT" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Margin="0,1" />
                                            <TextBlock Grid.Row="2" Text="Ablaufdatum JJMMTT" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding DateOfExpiry, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Margin="0,1" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseCan}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="CAN (6 Ziffern)" Width="130" VerticalAlignment="Center" />
                                        <TextBox Style="{StaticResource Mono}" Text="{Binding Can, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Width="90" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AccessKeyHint}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,0" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox DockPanel.Dock="Top" Header="Ablauf">
                                <StackPanel Margin="4">
                                    <CheckBox Content="PACE bevorzugen (sonst BAC / BAP)" IsChecked="{Binding PreferPace}" />
                                    <CheckBox Content="Chip Authentication" IsChecked="{Binding RunChipAuthentication}" />
                                    <CheckBox Content="Terminal Authentication (DG3/DG4, IDL: EAP)" IsChecked="{Binding RunTerminalAuthentication}" />
                                    <CheckBox Content="Active Authentication" IsChecked="{Binding RunActiveAuthentication}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Dokument lesen" Command="{Binding ReadDocumentCommand}" FontWeight="Bold" />
                                        <Button Content="Abbrechen" Command="{Binding CancelReadCommand}" />
                                    </StackPanel>
                                    <Button Content="Zulassungsbescheinigung (eVRC) lesen" Command="{Binding ReadEvrcCommand}" HorizontalAlignment="Left"
                                            ToolTip="RL 2003/127/EG – frei lesbar, keine Zugangsdaten nötig" />
                                    <ProgressBar Height="14" Margin="0,4,0,0" Value="{Binding ReadProgress}" />
                                    <TextBlock Text="{Binding ReadStage}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Ergebnis">
                                <ItemsControl ItemsSource="{Binding ReadSteps}" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="Bold" Text="{Binding Outcome, Converter={x:Static vm:StepOutcomeConverter.Instance}}"
                                                           Foreground="{Binding Outcome, Converter={x:Static vm:StepOutcomeConverter.Instance}, ConverterParameter=brush}" />
                                                <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </DockPanel>

                        <!-- MRZ aus DG1 -->
                        <DockPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DataPanelTitle}" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBox DockPanel.Dock="Top" Style="{StaticResource Mono}" FontSize="15" Text="{Binding MrzText, Mode=OneWay}" IsReadOnly="True"
                                     HorizontalScrollBarVisibility="Auto" />
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding MrzFindings}" Foreground="DarkOrange" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding MrzRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" Margin="0,4,0,0" CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Feld" Binding="{Binding Name}" Width="170" />
                                    <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="*" FontFamily="Consolas" />
                                    <DataGridTextColumn Header="Prüfung" Binding="{Binding Check}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Gesichtsbild aus DG2 -->
                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Bild speichern…" Command="{Binding SaveFaceImageCommand}" Margin="0" />
                                <TextBlock Text="{Binding ImagePanelTitle}" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding FaceInfo}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="1" Background="White" Height="70" Margin="0,4,0,0"
                                    ToolTip="DG5 – Unterschrift">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SignatureBitmap}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding SignatureBitmap}" Stretch="Uniform" />
                            </Border>
                            <Border BorderBrush="LightGray" BorderThickness="1" Background="WhiteSmoke">
                                <Image Source="{Binding FaceBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </DockPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Führerscheindaten">
                    <DataGrid ItemsSource="{Binding IdlFields}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserSortColumns="False" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datengruppe / Template" Binding="{Binding Path}" Width="170" />
                            <DataGridTextColumn Header="Tag" Binding="{Binding TagHex}" Width="55" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}" Width="260" />
                            <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn Header="Befund (ISO/IEC 18013-2 Anhang C)" Width="340" Binding="{Binding Findings, Converter={x:Static vm:JoinLinesConverter.Instance}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="DarkOrange" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Fahrzeugdaten">
                    <DataGrid ItemsSource="{Binding EvrcFields}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserSortColumns="False" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datei / Template" Binding="{Binding Path}" Width="180" />
                            <DataGridTextColumn Header="Tag" Binding="{Binding TagHex}" Width="55" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}" Width="320" />
                            <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn Header="Befund" Width="300" Binding="{Binding Findings, Converter={x:Static vm:JoinLinesConverter.Instance}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="DarkOrange" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Dateien">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Datensatz (Set) speichern…" Command="{Binding SaveSetCommand}" FontWeight="Bold"
                                        ToolTip="Ordner mit project.json und ef/*.bin nach SET-FORMAT.md (Import in PaceSetupGen)" />
                                <Button Content="Datei speichern…" Command="{Binding SaveSelectedFileCommand}"
                                        ToolTip="Ausgewählte Datei (oberste Ebene im Baum) als DG&lt;n&gt;.bin / EF.xxx.bin speichern" />
                            </StackPanel>
                            <TreeView ItemsSource="{Binding FileNodes}" SelectedItemChanged="FileTree_SelectedItemChanged">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Header}" FontFamily="Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFindings}" Value="True">
                                                            <Setter Property="Foreground" Value="DarkOrange" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                        <DockPanel Grid.Column="2">
                            <TextBox DockPanel.Dock="Top" Style="{StaticResource Mono}" Text="{Binding SelectedFileNode.Details, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" />
                            <TextBox Style="{StaticResource Mono}" Text="{Binding SelectedFileNode.HexDump, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,0"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Sicherheit">
                    <TextBox Style="{StaticResource Mono}" Text="{Binding SecurityReport, Mode=OneWay}" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </TabItem>
                <TabItem Header="PKI">
                    <DockPanel Margin="4">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Importieren…" Command="{Binding ImportPkiCommand}" FontWeight="Bold"
                                    ToolTip="CV-Zertifikate (CVCA, DV, Terminal), private Terminalschlüssel (PKCS#8/PEM), CSCA/DS (X.509), Master Lists, CRLs – Mehrfachauswahl möglich" />
                            <Button Content="Aktualisieren" Command="{Binding RefreshPkiCommand}" />
                            <Button Content="Ordner öffnen" Command="{Binding OpenPkiFolderCommand}" />
                            <TextBlock VerticalAlignment="Center" Foreground="DimGray" Margin="8,0,0,0"
                                       Text="Für TA: CVCA-, DV- und Terminalzertifikat sowie den privaten Schlüssel des Terminals importieren." />
                        </StackPanel>
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource Mono}" Text="{Binding PkiImportLog, Mode=OneWay}" IsReadOnly="True"
                                 MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource Mono}" Text="{Binding PkiSummary, Mode=OneWay}" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Leser / Karte">
                    <TextBox Style="{StaticResource Mono}" Text="{Binding CardInfo, Mode=OneWay}" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </TabItem>
                <TabItem Header="APDU-Konsole">
                    <DockPanel Margin="4">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="Senden" Command="{Binding SendApduCommand}" IsDefault="True" />
                            <CheckBox DockPanel.Dock="Right" Content="61xx/6Cxx automatisch" IsChecked="{Binding AutoGetResponse}" VerticalAlignment="Center" Margin="6,0" />
                            <TextBox Style="{StaticResource Mono}" Text="{Binding ApduInput, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBox Style="{StaticResource Mono}" Text="{Binding ApduOutput, Mode=OneWay}" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" />
                    </DockPanel>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
            <DockPanel Grid.Row="2">
                <Expander DockPanel.Dock="Right" ExpandDirection="Left" Header="Logdetails">
                    <ItemsControl ItemsSource="{Binding LogLevels}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Category}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding Level}"
                                              ItemsSource="{Binding DataContext.AvailableLevels, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock Text="Kommunikations- und Berechnungslog" FontWeight="Bold" VerticalAlignment="Center" Margin="4" />
                    <Button Content="Leeren" Command="{Binding ClearLogCommand}" />
                    <Button Content="Speichern…" Command="{Binding SaveLogCommand}" />
                </StackPanel>
                <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="12"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Mode=OneWay, Converter={x:Static vm:LogEntryFormatter.Instance}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Foreground" Value="Red" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Foreground" Value="DarkOrange" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Direction}" Value="Command">
                                                <Setter Property="Foreground" Value="DarkBlue" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Direction}" Value="Response">
                                                <Setter Property="Foreground" Value="DarkGreen" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
