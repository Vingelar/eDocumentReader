<Window x:Class="eDocumentReader.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:eDocumentReader.App.Localization"
        Title="{l:Tr 'Über eDocumentReader', En='About eDocumentReader'}"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:Tr 'Schließen', En='Close'}" IsDefault="True" IsCancel="True" Padding="16,3" Click="Close_Click" />
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="Version" Foreground="DimGray" Margin="0,2,0,10" />
            <ItemsControl x:Name="Paragraphs">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DockPanel>
</Window>
